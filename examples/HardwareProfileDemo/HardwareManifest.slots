# Board slots of the GPIO role parameters (Build-HardwareProfile.ps1). Commit this file.
# Never edit or reuse a number: it is part of the ETS parameter ID of every GPIO role.
0x1310 = 0
0x1320 = 1
0x1132 = 2
0x1021 = 3
0x1022 = 4
0x1203 = 5
0x2400 = 6
0x2121 = 7
0x3F00 = 8
0x3F01 = 9
0x3F02 = 10
0x3F10 = 11
0x3F11 = 12
0x3F12 = 13
0x3F13 = 14
0x3F14 = 15
# Bit order of the device query (firmware in the field reads by position): a name keeps its bit, new names are appended; never remove a line.
cap 0 = ThirdParty
cap 1 = Tp
cap 2 = Lan
cap 3 = Wifi
cap 4 = Display
cap 5 = Rtc
cap 6 = SdCard
cap 7 = Buzzer
cap 8 = LargeFlash
cap 9 = PowerMeter
cap 10 = Temperature
cap 11 = FrontControls
cap 12 = TempHum
cap 13 = Co2
cap 14 = Lux
cap 15 = Presence
cap 16 = SensorModule
val 0 = BinaryInputs
val 1 = StatusLeds
val 2 = FlashMB
val 3 = Relays
# Rules of <Filters> with an own list: the slot is part of the ETS parameter ID of that list; never change, reuse or remove a slot (an edited rule: write its new key into its line).
filter ChFunction board:DEMO_SHELLY_* = 0
filter ChFunction capability:PowerMeter = 1
filter Function board:DEMO_SHELLY_* = 0
filter Function board:DEMO_SHELLY_PLUS_1PM = 1
filter Function board:DEMO_SHELLY_PLUS_2PM = 2
filter Function board:DEMO_SHELLY_PLUS_I4 = 3
filter Function board:DEMO_SHELLY_PLUG_S = 4
filter TimeSource capability:Lan = 0
filter TimeSource board:* = 1
filter TimeSource capability:Wifi = 2
# ETS content per product XML: ets "<file>" <ApplicationVersion> <fingerprint>; kept until the version changes
ets "HardwareProfileDemo.xml" 3.2 1CF261DFF0E8FAEF
